# Darksteel Mail — Environment variables
# Copy this file to .env.local and fill in real values. Do NOT commit .env.local.

# ============ Supabase ============
# Public URL — safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon key — safe to expose to browser (RLS protects it)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role key — SERVER ONLY, NEVER prefixed with NEXT_PUBLIC_
# Used in webhook handlers and server actions to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ============ Stripe ============
# Switch between test and live modes
STRIPE_MODE=test

# Test mode keys (use while developing)
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Live mode keys (fill in before launch)
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# ============ App ============
# Used for Stripe success/cancel URLs and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Operator email for admin access (milestone 5)
ADMIN_EMAIL=mike@darksteelmail.com

# ============ Email (milestone 4) ============
# Resend for transactional email
RESEND_API_KEY=re_...

# ============ Development ============
# Set to 1 to enable verbose logging in server routes
DEBUG=0
